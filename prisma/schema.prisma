generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  nameEn       String
  email        String   @unique
  passwordHash String
  role         String
  department   String
  permissions  String   @default("[]")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("users")
}

model Asset {
  id        String   @id @default(cuid())
  type      String
  prompt    String
  resultUrl String?
  status    String   @default("done")
  userId    String
  createdAt DateTime @default(now())

  @@map("assets")
}

model ChatLog {
  id        String   @id @default(cuid())
  role      String
  content   String
  userId    String
  createdAt DateTime @default(now())

  @@map("chat_logs")
}
